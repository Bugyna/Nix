theme="elf"
tab_size=3
# CRLF or LF
line_end=LF
show_keypress=1

orientate = "down"
show_buffer_tab = 1
start_width = 80
start_height = 32

change_line_no = change_line_no_number
show_buffer_name=0

font="Terminal"

font_size=14
smaller_font_size=12

allow_external_modules=0

selection_border_width=0
cursor_blink_time=0
cursor_border_width=0

# "/" (regex search) or "?" (normal search)
default_find_mode="?" 
alpha=100
# UTC+n or UTC-n
timezone="UTC" 

# ignore warnings generated by key binding at editor startup
supress_keybind_warning=0


command_entry_font_size= 13
find_entry_font_size = 12
command_out_font_size = 14

# show info_frame
show_info = 1

# show line_numbers
show_line_numbers=0

